{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify toxicity classification API backed by Postgres + pgvector and Cloudflare Workers AI embeddings.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node --env-file=.env dist/main.js",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed": "tsx --env-file=.env src/seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "langchain": "^0.3.37",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.test.ts"]
  }
}
